{
  "compilerOptions": {
    "target": "ES2020",
  "module": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
  "moduleResolution": "node16"
  },
  "include": ["src"],
  "exclude": ["**/__tests__/**", "**/*.test.ts"]
}